# Normalize text files in the repository so Windows/Linux checkouts do not
# create noisy line-ending-only diffs.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary project assets.
*.wav binary
*.flac binary
*.mp3 binary
*.pt binary
*.pth binary
*.ckpt binary
*.png binary
*.jpg binary
*.jpeg binary
