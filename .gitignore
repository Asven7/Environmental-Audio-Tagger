# Python virtual environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test / analysis caches
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local configuration / secrets
.env
.env.*

# Local datasets (UrbanSound8K is not redistributed)
data/
UrbanSound8K/

# Model checkpoints are ignored by default
*.pt
*.pth
*.ckpt

# Generated research artifacts are ignored. Retain the small synthetic files
# needed to test inference from a fresh checkout.
artifacts/*
!artifacts/.gitkeep
!artifacts/demo_cnn/
!artifacts/demo_cnn/**
!artifacts/demo_crnn/
!artifacts/demo_crnn/**
!artifacts/demo_pipeline_summary.json

# Temporary/local logs
*.log
